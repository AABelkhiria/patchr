{
  "name": "patchr",
  "displayName": "Patchr",
  "description": "Generate, save, and apply Git patches (.patch) directly from VS Code",
  "version": "0.0.1",
  "publisher": "AshBelkhiria",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "patchr",
    "patch",
    "diff",
    "git",
    "staged",
    "version control"
  ],
  "activationEvents": [],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "patchr.saveStagedDiff",
        "title": "Patchr: Save Staged Changes to Patch File"
      },
      {
        "command": "patchr.saveUnstagedDiff",
        "title": "Patchr: Save Unstaged Changes to Patch File"
      },
      {
        "command": "patchr.saveAllDiff",
        "title": "Patchr: Save All Changes (Staged & Unstaged) to Patch File"
      },
      {
        "command": "patchr.saveCurrentFileDiff",
        "title": "Patchr: Save File Changes to Patch File"
      },
      {
        "command": "patchr.applyDiff",
        "title": "Patchr: Apply Patch File"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "patchr.applyDiff",
          "when": "resourceExtname == .patch || resourceExtname == .diff",
          "group": "patchr@1"
        },
        {
          "command": "patchr.saveCurrentFileDiff",
          "when": "!explorerResourceIsFolder",
          "group": "patchr@2"
        }
      ],
      "scm/title": [
        {
          "command": "patchr.saveStagedDiff",
          "group": "patchr@1"
        },
        {
          "command": "patchr.saveUnstagedDiff",
          "group": "patchr@2"
        },
        {
          "command": "patchr.saveAllDiff",
          "group": "patchr@3"
        },
        {
          "command": "patchr.applyDiff",
          "group": "patchr@4"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "patchr.saveStagedDiff",
          "when": "scmProvider == git && scmResourceGroup == staged",
          "group": "patchr"
        },
        {
          "command": "patchr.saveUnstagedDiff",
          "when": "scmProvider == git && scmResourceGroup == workingTree",
          "group": "patchr"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "patchr.saveCurrentFileDiff",
          "when": "scmProvider == git",
          "group": "patchr"
        }
      ],
      "editor/context": [
        {
          "command": "patchr.saveCurrentFileDiff",
          "group": "patchr@1"
        },
        {
          "command": "patchr.applyDiff",
          "when": "resourceExtname == .patch || resourceExtname == .diff",
          "group": "patchr@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "patchr.saveCurrentFileDiff",
          "group": "patchr@1"
        },
        {
          "command": "patchr.applyDiff",
          "when": "resourceExtname == .patch || resourceExtname == .diff",
          "group": "patchr@2"
        }
      ]
    },
    "configuration": {
      "title": "Patchr",
      "properties": {
        "patchr.appendPatchExtension": {
          "type": "boolean",
          "default": true,
          "description": "Automatically append .patch extension to the filename if not provided."
        },
        "patchr.slugifyFilename": {
          "type": "boolean",
          "default": true,
          "description": "Automatically replace spaces and special characters with dashes (-) in the filename."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AABelkhiria/diff.git"
  },
  "homepage": "https://github.com/AABelkhiria/diff#readme",
  "bugs": {
    "url": "https://github.com/AABelkhiria/diff/issues"
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.3"
  }
}